# .env.example — Variables de entorno para la API FastAPI
# Copiar como .env para desarrollo local (NO commitear .env)
# En Render: configurar directamente en el panel de Environment Variables

# ── Obligatorias ──────────────────────────────────────────────────────────────

# Contenido completo de credenciales.json como string JSON en una sola línea.
# Ejemplo: GCP_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# En Render: pegar el JSON completo de credenciales.json en el campo de valor.
GCP_SERVICE_ACCOUNT=

# Contraseña de acceso a la app (reservada para autenticación futura de la API)
APP_PASSWORD=

# ── Opcionales ────────────────────────────────────────────────────────────────

# Orígenes CORS permitidos, separados por coma.
# Desarrollo: dejar en "*" (permite cualquier origen)
# Producción: poner la URL exacta del cliente Flutter
# Ejemplo: CORS_ORIGINS=https://mi-perfumeria.flutter.com,https://admin.perfumeria.com
CORS_ORIGINS=*

# Puerto (Render lo inyecta automáticamente como $PORT)
# No es necesario configurarlo manualmente en Render.
PORT=8000
