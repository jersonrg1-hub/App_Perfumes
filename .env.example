# .env.example — Variables de entorno para la API FastAPI
# Copiar como .env para desarrollo local (NO commitear .env)
# En Render: configurar directamente en el panel de Environment Variables

# ── Obligatorias ──────────────────────────────────────────────────────────────

# Contenido completo de credenciales.json como string JSON en una sola línea.
# Ejemplo: GCP_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
GCP_SERVICE_ACCOUNT=

# Clave secreta para endpoints protegidos (ventas, cotizaciones, estadísticas).
# Header requerido: X-API-Key: <valor>
# Usar una cadena aleatoria de 32+ caracteres.
API_KEY=

# ── Opcionales ────────────────────────────────────────────────────────────────

# Orígenes CORS permitidos, separados por coma.
# Desarrollo: dejar en "*"
# Producción: poner la URL exacta del cliente si aplica
CORS_ORIGINS=*

# Entorno (activa advertencias de seguridad en logs)
ENVIRONMENT=development

# Puerto (Render lo inyecta automáticamente como $PORT)
PORT=8000
