{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FastAPI server",
            "type": "shell",
            "command": "${workspaceFolder}/pythonProject/.venv_n/Scripts/python.exe -m uvicorn backend.api.main:app --reload --port 8000",
            "options": {
                "cwd": "${workspaceFolder}/pythonProject"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run tests (pytest)",
            "type": "shell",
            "command": "${workspaceFolder}/pythonProject/.venv_n/Scripts/python.exe -m pytest",
            "options": {
                "cwd": "${workspaceFolder}/pythonProject"
            },
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
